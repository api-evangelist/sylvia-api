{
  "name": "Sylvia API",
  "description": "Read-only Reddit data gateway \u2014 posts, comments with recursive threads, subreddits, users, search, and live streams, served as JSON and via an MCP server.",
  "url": "https://sylvia-api.com",
  "version": "2.0.0",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "stateTransitionHistory": false
  },
  "defaultInputModes": [
    "text"
  ],
  "defaultOutputModes": [
    "text"
  ],
  "authentication": {
    "schemes": [
      "apiKey"
    ],
    "apiKey": {
      "header": "X-API-KEY"
    }
  },
  "endpoint": "https://api.sylvia-api.com/mcp",
  "openapi": "https://sylvia-api.com/openapi.json",
  "llmsTxt": "https://sylvia-api.com/llms.txt"
}
